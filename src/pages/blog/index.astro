---
import { ArrowRight } from "@lucide/astro";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<Base title="公开文章 · mopango" description="通信、FPGA、Linux 与实验系统的公开工程记录。">
  <main class="shell archive">
    <header class="archive-intro"><div class="eyebrow">Public Notes</div><h1>公开文章</h1><p>可以复现的实验过程、值得保留的技术判断，以及对其他人有帮助的工具和方法。</p></header>
    <div class="archive-list">{posts.map((post) => <a class="archive-row" href={`/blog/${post.id}/`}>
      <time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString("zh-CN")}</time>
      <div><h2>{post.data.title}</h2><p>{post.data.description}</p></div>
      <div class="tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}<ArrowRight size={17} /></div>
    </a>)}</div>
  </main>
</Base>
