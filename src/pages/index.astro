---
import { ArrowRight, GitPullRequest, LogIn } from "@lucide/astro";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import GithubMark from "../components/GithubMark.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf()).slice(0, 3);
const labAccessUrl = import.meta.env.PUBLIC_LAB_ACCESS_URL;
---
<Base>
  <main>
    <section class="hero">
      <img class="hero-image" src="/hero-portrait.webp" alt="晚霞与城市天际线前的人物背影" width="2400" height="1600" fetchpriority="high" />
      <div class="shell hero-inner">
        <div class="eyebrow">Chengdu · Engineering Notes</div>
        <h1>把复杂系统，做成可以验证的东西。</h1>
        <p class="lede">我是 mopango。这里记录通信、FPGA、Linux 与实验基础设施，也保存那些从失败里长出来的工程判断。</p>
        <div class="actions">
          <a class="button primary" href="#writing">阅读文章 <ArrowRight size={17} /></a>
          <a class="button" href="https://github.com/LJnXn" target="_blank" rel="noreferrer"><GithubMark size={17} /> GitHub</a>
        </div>
      </div>
    </section>

    <section class="band" id="projects"><div class="shell">
      <div class="section-head"><div><div class="eyebrow">Public Projects</div><h2>公开项目</h2></div><p>此处只列出 GitHub 上当前公开、未归档的项目。</p></div>
      <div class="project-grid" id="public-projects"><p class="project-status">正在读取公开项目...</p></div>
    </div></section>

    <section class="band" id="writing"><div class="shell">
      <div class="section-head"><div><div class="eyebrow">Public Notes</div><h2>公开文章</h2></div><p>研究札记、调试记录和能被复用的方法。</p></div>
      <div class="post-grid">{posts.map((post) => <a class="post" href={`/blog/${post.id}/`}><div class="meta"><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString("zh-CN")}</time></div><h3>{post.data.title}</h3><p>{post.data.description}</p></a>)}</div>
    </div></section>

    <section class="band" id="access"><div class="shell private-band">
      <div><div class="eyebrow">Controlled Access</div><h2>实验室入口</h2><p>新用户提交合作者申请，由仓库所有者批准。白名单用户完成 GitHub 认证后直接进入树莓派控制中枢，可使用其中的 NAS、Cockpit、终端与实验室应用。</p></div>
      <div class="actions">
        <a class="button" href="https://github.com/LJnXn/LJnXn.github.io/issues/new?template=collaborator.yml" target="_blank" rel="noreferrer"><GitPullRequest size={17} /> 申请成为合作者</a>
        {labAccessUrl ? <a class="button primary" href={labAccessUrl} rel="noreferrer"><LogIn size={17} /> 登录并进入控制中枢</a> : <span class="button" aria-disabled="true"><LogIn size={17} /> 登录入口配置中</span>}
      </div>
    </div></section>

    <figure class="closing-photo">
      <img src="/hero-wuhan.webp" alt="武汉夜色中写有祝福的玻璃与城市灯光" width="2400" height="1600" loading="lazy" />
      <figcaption class="shell"><span>Wuhan · 2026</span></figcaption>
    </figure>
  </main>
  <script>
    type PublicRepository = {
      archived: boolean;
      description: string | null;
      fork: boolean;
      html_url: string;
      language: string | null;
      name: string;
    };

    const grid = document.querySelector("#public-projects");
    const status = grid?.querySelector(".project-status");
    const repositoryUrl = "https://api.github.com/users/LJnXn/repos?sort=updated&per_page=100";

    function projectCard(repository: PublicRepository) {
      const link = document.createElement("a");
      link.className = "project";
      link.href = repository.html_url;
      link.target = "_blank";
      link.rel = "noreferrer";

      const meta = document.createElement("div");
      meta.className = "meta";
      meta.textContent = repository.language || "GitHub";
      const title = document.createElement("h3");
      title.textContent = repository.name;
      const description = document.createElement("p");
      description.textContent = repository.description || "查看项目代码与文档。";
      link.append(meta, title, description);
      return link;
    }

    fetch(repositoryUrl, { cache: "no-store", headers: { Accept: "application/vnd.github+json" } })
      .then((response) => {
        if (!response.ok) throw new Error(`GitHub API ${response.status}`);
        return response.json();
      })
      .then((repositories: PublicRepository[]) => {
        const visible = repositories
          .filter((repository) => !repository.fork && !repository.archived && repository.name !== "LJnXn.github.io")
          .slice(0, 6);
        grid?.replaceChildren(...(visible.length ? visible.map(projectCard) : [Object.assign(document.createElement("p"), { className: "project-status", textContent: "暂无公开项目。" })]));
      })
      .catch(() => {
        if (status) status.textContent = "公开项目暂时无法读取，请前往 GitHub 查看。";
      });
  </script>
</Base>
