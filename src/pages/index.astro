---
import { ArrowRight, ExternalLink, GitPullRequest, LogIn, UserRoundCheck } from "@lucide/astro";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import GithubMark from "../components/GithubMark.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf()).slice(0, 3);
const labAccessUrl = import.meta.env.PUBLIC_LAB_ACCESS_URL;
const projects = [
  { name: "MyTinySTL", type: "C++", text: "以 C++11 实现一个紧凑的 STL，用于理解容器、迭代器和泛型设计。", url: "https://github.com/LJnXn/MyTinySTL" },
  { name: "Tinyhttpd", type: "网络", text: "通过小型 HTTP Server 理解请求解析、CGI 与服务器程序的基本结构。", url: "https://github.com/LJnXn/Tinyhttpd" },
  { name: "ISAC / Tiny NPU / Lab Hub", type: "整理中", text: "正在从私有工程中抽取不含凭据、实验数据和内网细节的可公开部分。" },
];
---
<Base>
  <main>
    <section class="hero">
      <img class="hero-image" src="/hero-wuhan.webp" alt="武汉夜色中写有祝福的玻璃与城市灯光" width="2400" height="1600" fetchpriority="high" />
      <div class="shell hero-inner">
        <div class="eyebrow">Chengdu · Engineering Notes</div>
        <h1>把复杂系统，做成可以验证的东西。</h1>
        <p class="lede">我是 mopango。这里记录通信、FPGA、Linux 与实验基础设施，也保存那些从失败里长出来的工程判断。</p>
        <div class="actions">
          <a class="button primary" href="#writing">阅读文章 <ArrowRight size={17} /></a>
          <a class="button" href="https://github.com/LJnXn" target="_blank" rel="noreferrer"><GithubMark size={17} /> GitHub</a>
        </div>
      </div>
    </section>

    <section class="band" id="projects"><div class="shell">
      <div class="section-head"><div><div class="eyebrow">Selected Work</div><h2>正在构建</h2></div><p>项目不只是结果，也包括环境、约束、测量方式和可复现过程。</p></div>
      <div class="project-grid">{projects.map((project) => project.url ? <a class="project" href={project.url} target="_blank" rel="noreferrer"><div class="meta">{project.type} <ExternalLink size={13} /></div><h3>{project.name}</h3><p>{project.text}</p></a> : <article class="project"><div class="meta">{project.type}</div><h3>{project.name}</h3><p>{project.text}</p></article>)}</div>
    </div></section>

    <section class="band" id="writing"><div class="shell">
      <div class="section-head"><div><div class="eyebrow">Public Notes</div><h2>公开文章</h2></div><p>研究札记、调试记录和能被复用的方法。</p></div>
      <div class="post-grid">{posts.map((post) => <a class="post" href={`/blog/${post.id}/`}><div class="meta"><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString("zh-CN")}</time></div><h3>{post.data.title}</h3><p>{post.data.description}</p></a>)}</div>
    </div></section>

    <section class="band" id="access"><div class="shell private-band">
      <div><div class="eyebrow">Controlled Access</div><h2>实验室入口</h2><p>Tailscale Funnel 只发布独立的受限入口。新用户先提交 GitHub 账号申请；批准后使用 GitHub 登录。公开主页不会暴露控制中枢、NAS、Cockpit 或 WebDAV。</p></div>
      <div class="actions">
        <a class="button" href="https://github.com/LJnXn/LJnXn.github.io/issues/new?template=access.yml" target="_blank" rel="noreferrer"><UserRoundCheck size={17} /> 申请访问</a>
        <a class="button" href="https://github.com/LJnXn/LJnXn.github.io/issues/new?template=collaborator.yml" target="_blank" rel="noreferrer"><GitPullRequest size={17} /> 申请成为合作者</a>
        {labAccessUrl ? <a class="button primary" href={labAccessUrl} rel="noreferrer"><LogIn size={17} /> 已批准用户登录</a> : <span class="button" aria-disabled="true"><LogIn size={17} /> 登录入口配置中</span>}
      </div>
    </div></section>
  </main>
</Base>
